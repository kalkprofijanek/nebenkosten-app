{
  "name": "nebenkosten-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "format": "prettier --write \"apps/**/*\" \"packages/**/*\" \"scripts/scan-repository-content.mjs\" \"tests/architecture/**/*\" \"tests/privacy/**/*\" \"tests/integration/**/*\" \"tests/migration/**/*\" \"tests/characterization/**/*.{ts,json,md}\" \"tests/e2e/**/*\" \"tests/setup-vitest.ts\" \"*.{json,js,ts,yaml}\" \".github/actions/**/*.yml\" \".github/dependabot.yml\" \".github/workflows/ci.yml\" \"docs/TASKS/PR-0*.md\" \"docs/ROUNDING.md\" \"docs/PERSISTENCE.md\"",
    "format:check": "prettier --check \"apps/**/*\" \"packages/**/*\" \"scripts/scan-repository-content.mjs\" \"tests/architecture/**/*\" \"tests/privacy/**/*\" \"tests/integration/**/*\" \"tests/migration/**/*\" \"tests/characterization/**/*.{ts,json,md}\" \"tests/e2e/**/*\" \"tests/setup-vitest.ts\" \"*.{json,js,ts,yaml}\" \".github/actions/**/*.yml\" \".github/dependabot.yml\" \".github/workflows/ci.yml\" \"docs/TASKS/PR-0*.md\" \"docs/ROUNDING.md\" \"docs/PERSISTENCE.md\"",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.tests.json --noEmit && pnpm -r --if-present typecheck",
    "test:architecture": "node --test tests/architecture/**/*.test.mjs",
    "test:repository": "node --test tests/repository/**/*.test.mjs",
    "test:repository:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=80 --test-coverage-functions=80 tests/repository/**/*.test.mjs tests/privacy/**/*.test.mjs",
    "test:privacy": "node --test tests/privacy/**/*.test.mjs",
    "test:unit": "vitest run --config vitest.config.ts && pnpm -r --if-present test",
    "test:unit:coverage": "vitest run --config vitest.config.ts --coverage && pnpm -r --if-present test:coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:migration": "vitest run --config vitest.migration.config.ts",
    "test:characterization": "vitest run --config vitest.characterization.config.ts",
    "test": "pnpm test:architecture && pnpm test:repository && pnpm test:privacy && pnpm test:unit && pnpm test:integration && pnpm test:migration && pnpm test:characterization",
    "test:coverage": "pnpm test:repository:coverage && pnpm test:unit:coverage",
    "test:e2e": "playwright test",
    "build": "pnpm -r --if-present build",
    "check:repository": "node scripts/verify-repository-guardrails.mjs",
    "privacy:scan": "pnpm check:repository && node scripts/scan-repository-content.mjs",
    "security:audit": "pnpm audit --audit-level high",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:coverage && pnpm build && pnpm privacy:scan && pnpm security:audit"
  },
  "engines": {
    "node": "22.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "@nebenkosten/core": "workspace:*",
    "@nebenkosten/import-export": "workspace:*",
    "@nebenkosten/pdf": "workspace:*",
    "@nebenkosten/persistence": "workspace:*",
    "@nebenkosten/schema": "workspace:*",
    "@nebenkosten/test-fixtures": "workspace:*",
    "@nebenkosten/ui": "workspace:*",
    "@nebenkosten/validators": "workspace:*",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
